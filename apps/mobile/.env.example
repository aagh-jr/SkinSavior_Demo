# skinsavior mobile (Expo) — environment variables
# Copy to `.env` and fill in your standalone Supabase project's values.
# EXPO_PUBLIC_ vars are inlined into the app bundle (client-readable).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY
