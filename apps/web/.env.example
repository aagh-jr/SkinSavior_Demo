# skinsavior web (Next.js) — environment variables
# Copy this file to `.env.local` and fill in your standalone Supabase project's values.
#
# These replace the old Lovable Cloud `VITE_SUPABASE_*` vars. The migration from
# Lovable auth to native Supabase Auth means you point these at YOUR Supabase
# project (Project Settings → API).

# Public — exposed to the browser. Safe to ship.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY

# Server-only — NEVER expose to the client. Used by src/lib/supabase/admin.ts
# (service-role client that bypasses RLS). Only set this if you need admin ops.
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# TEMPORARY kill switch. When "true", all Supabase clients fall back to a no-op
# stub (src/lib/supabase/mock.ts) that returns empty data and never hits the
# network — useful so AI design tools can render the app without a live
# Supabase connection. Leave unset/false for normal development.
# NEXT_PUBLIC_SUPABASE_DISABLED=true

# Server-only — Claude API key for the AI pipelines (product URL ingest,
# routine compatibility, skin-log summarization). Get one at
# https://platform.claude.com. Used by src/app/api/products/ingest/route.ts.
# ANTHROPIC_API_KEY=sk-ant-...
