# skinsavior web (Next.js) — environment variables
# Copy this file to `.env.local` and fill in your standalone Supabase project's values.
#
# These replace the old Lovable Cloud `VITE_SUPABASE_*` vars. The migration from
# Lovable auth to native Supabase Auth means you point these at YOUR Supabase
# project (Project Settings → API).

# Public — exposed to the browser. Safe to ship.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY

# Server-only — NEVER expose to the client. Used by src/lib/supabase/admin.ts
# (service-role client that bypasses RLS). Required for ingest + admin ops.
# Use the legacy service_role JWT (the `sb_secret_…` format is rejected).
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Server-only — non-public Supabase URL. Optional; admin.ts falls back to
# NEXT_PUBLIC_SUPABASE_URL when unset.
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# TEMPORARY kill switch. When "true", all Supabase clients fall back to a no-op
# stub (src/lib/supabase/mock.ts) that returns empty data and never hits the
# network — useful so AI design tools can render the app without a live
# Supabase connection. Leave unset/false for normal development.
# NEXT_PUBLIC_SUPABASE_DISABLED=true

# Server-only — Claude API key for the AI pipelines (product URL ingest,
# routine compatibility, skin-log summarization). Get one at
# https://platform.claude.com. Used by src/app/api/products/ingest/route.ts.
# ANTHROPIC_API_KEY=sk-ant-...

# Server-only — Firecrawl API key. OPTIONAL. When set, the product ingest
# pipeline uses Firecrawl as a last-resort scraper for pages the plain fetch
# can't get (JS-rendered storefronts / anti-bot walls like Target, Sephora).
# When unset, ingest behaves exactly as before (plain fetch only). Get a key at
# https://www.firecrawl.dev. Used by src/lib/ingest.ts.
# FIRECRAWL_API_KEY=fc-...

# Server-only — Upstash Redis, used for per-user rate limiting on the paid AI
# endpoints (src/lib/rate-limit.ts). Create a free database at
# https://upstash.com → REST API. REQUIRED: rate limiting now FAILS CLOSED —
# when these are unset the paid AI endpoints return 503 rather than running
# unmetered. Set both before those features can work.
# UPSTASH_REDIS_REST_URL=https://YOUR-DB.upstash.io
# UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_REST_TOKEN

# Server-only — Google Gemini API key for the evidence-explainer surface.
# GEMINI_API_KEY=...

# Comma-separated admin emails granted elevated access (src/lib admin gating).
# ADMIN_EMAILS=you@example.com

# Demo splash at "/". Unset = demo disabled (visitors get /landing). NOTE: the
# old behavior that minted a real session with no password has been removed;
# this now only gates whether the splash renders.
DEMO_ACCOUNT_EMAIL=

# NCBI E-utilities (research pipeline). Contact email is requested by NCBI;
# the API key raises the rate limit. Both optional.
NCBI_CONTACT_EMAIL=
# NCBI_API_KEY=
